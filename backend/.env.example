# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | production
ENVIRONMENT=development

# Database. SQLite for local development; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nuvia
DATABASE_URL=sqlite:///./nuvia.db

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Front-end origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Cooking assistant (Groq, free): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any chat model with tool use listed at https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
